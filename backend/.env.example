# ==============================================================================
# BrainCX Backend Environment Variables (Mock / Example Configuration)
# Copy this file to .env and provide your actual credentials.
# ==============================================================================

# Google Calendar OAuth 2.0 Credentials
# Obtain these from Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID="123456789012-mockclientidabc123def456.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="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2"
GOOGLE_REFRESH_TOKEN="1//04mockRefreshToken_aBcDeFgHiJkLmNoPqRsTuVwXyZ"

# Target Google Calendar ID (use 'primary' or a specific dedicated calendar like demos@braincx.com)
GOOGLE_CALENDAR_ID="primary"

# Environment Mode: 'production', 'development', or 'test'
ENVIRONMENT="production"

# Vapi Webhook Secret Token (Shared secret set in Vapi Dashboard > Server URL / Custom Headers)
# Example Header configured in Vapi: X-Vapi-Secret: your-secret-token-here
VAPI_SECRET_TOKEN="your-secure-random-vapi-secret-token"

# Allow fallback to in-memory mock calendar if Google credentials are not configured
# Set to 'false' in production so credential failures fail loudly
ENABLE_MOCK_FALLBACK=false

# Auto-generate Google Meet conference links for scheduled meetings
CREATE_GOOGLE_MEET_LINK=true

# BrainCX Representative email to automatically include in meeting invites
ORGANIZER_EMAIL="demos@braincx.com"

# Allowed CORS Origins (comma-separated list for Next.js web client)
ALLOWED_ORIGINS="http://localhost:3000,https://voice.braincx.com,https://braincx.ai"

# Server Host and Port
HOST="0.0.0.0"
PORT=8000

# Calendar Slot Rules (Business Hours & Duration)
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=17
MEETING_DURATION_MINUTES=30
TIMEZONE_DEFAULT="America/New_York"

